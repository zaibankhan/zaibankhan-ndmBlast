# ── NDM-BLAST email settings (for the "Save → Send to Email" option) ──────────
# Copy this file to ".env" and fill in your values. The ".env" file is ignored
# by git, so your password is never committed.
#
# Gmail users: create an App Password (Google Account → Security → App
# passwords) and use that as NDM_MAIL_PASSWORD. Normal passwords will not work.

NDM_MAIL_HOST=smtp.gmail.com
NDM_MAIL_PORT=587
NDM_MAIL_USE_TLS=1
NDM_MAIL_USER=your.address@gmail.com
NDM_MAIL_PASSWORD=your-16-character-app-password
NDM_MAIL_FROM=your.address@gmail.com
